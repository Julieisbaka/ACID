{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://acid-benchmark.org/schemas/models-v1.json",
    "title": "ACID Model Registry",
    "description": "Provider/model configuration for benchmark models and the standardized judge.",
    "type": "object",
    "required": [
        "models",
        "scoring_model"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string",
            "format": "uri-reference"
        },
        "models": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/model"
            }
        },
        "scoring_model": {
            "$ref": "#/$defs/model"
        }
    },
    "$defs": {
        "model": {
            "type": "object",
            "required": [
                "provider",
                "model"
            ],
            "additionalProperties": false,
            "properties": {
                "provider": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "model": {
                    "type": "string",
                    "minLength": 1
                },
                "reasoning_effort": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "enum": [
                        "low",
                        "medium",
                        "high",
                        null
                    ],
                    "description": "Optional provider reasoning level. Null omits the API parameter."
                },
                "base_url": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "uri"
                },
                "http_referer": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "app_title": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        }
    }
}
